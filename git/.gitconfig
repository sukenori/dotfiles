[user]
	name = sukenori
	email = sukenori@coo.net

# PATを .git-credentials に保存
[credential]
	helper = "!f() { /root/.vscode-server/bin/a5b500951314efd502d07465bd138dfbd714a960/node /tmp/vscode-remote-containers-5ac486f0-2a85-441c-822f-a18c676d222d.js git-credential-helper $*; }; f"

# チェックアウト時は改行変換しない、コミット時に CRLF → LF に変換する
[core]
	autocrlf = input

[safe]
	directory = /home/sukenori/atcoder-nim-env
	directory = /home/sukenori/cp-nim-lib
	directory = /home/sukenori/nim-acl
	directory = /home/sukenori/cp-solved-log
