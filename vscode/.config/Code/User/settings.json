{
  // VSCode 全体で使う共通設定（言語個別設定は各 workspace 側へ置く）
  "editor.fontFamily": "HackGen Console NF",
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/usr/bin/zsh"
    }
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  // CUI 操作感を維持するため、vscode-neovim を標準で有効化する
  "vscode-neovim.useCtrlKeys": true,
  "vscode-neovim.neovimExecutablePaths.linux": "/usr/local/bin/nvim",
  "vscode-neovim.neovimInitVimPaths.linux": "/home/sukenori/.config/nvim/init.lua"
}
